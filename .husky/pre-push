#!/usr/bin/env bash
# pre-push: بوابة Audit الإلزامية قبل الدفع.
# لتجاوز مؤقت (في حالات الطوارئ فقط): git push --no-verify
set -e

echo ""
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo "  بوابة Audit — نظام إدارة وقف مرزوق بن علي الثبيتي"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

if ! command -v npm >/dev/null 2>&1; then
  echo "✗ npm غير متوفر في PATH — تعذّر تشغيل البوابة."
  exit 1
fi

echo "▶ 0/2 فحص ملفات .env المتعقّبة..."
TRACKED_ENV=$(git ls-files | grep -E '(^|/)\.env(\..+)?$' | grep -v '\.example$' || true)
if [ -n "$TRACKED_ENV" ]; then
  echo "✗ ملفات .env التالية متعقّبة في git ويجب إزالتها قبل الـ push:"
  echo "$TRACKED_ENV" | sed 's/^/   • /'
  echo ""
  echo "  للإصلاح: git rm --cached <file> && git commit -m \"untrack env\""
  echo "  للتجاوز الطارئ فقط: git push --no-verify"
  exit 1
fi
echo "✓ لا توجد ملفات .env متعقّبة"
echo ""

if ! npm run -s audit; then
  echo ""
  echo "✗ فشلت سلسلة Audit. راجع audit/report.html و audit/*.md"
  echo "  للتجاوز الطارئ فقط: git push --no-verify"
  exit 1
fi

echo ""
echo "▶ 2/2 تشغيل اختبار البوابة الحرجة (auditCriticalGate)..."
if ! npm run -s audit:gate; then
  echo ""
  echo "✗ اختبار البوابة الحرجة فشل. الـ push ممنوع."
  echo "  للتجاوز الطارئ فقط: git push --no-verify"
  exit 1
fi

echo ""
echo "✓ بوابة Audit اجتازت — يُسمح بالـ push."
